          request.resource.data.openingMinute is int && request.resource.data.closingMinute is int && request.resource.data.openingMinute >= 0 && request.resource.data.closingMinute <= 1440 && request.resource.data.openingMinute < request.resource.data.closingMinute &&
          request.resource.data.open.matches('^[0-9]{2}:[0-9]{2}$') && request.resource.data.close.matches('^[0-9]{2}:[0-9]{2}$') &&
          int(request.resource.data.open.split(':')[0]) < 24 && int(request.resource.data.open.split(':')[1]) < 60 && int(request.resource.data.close.split(':')[0]) < 24 && int(request.resource.data.close.split(':')[1]) < 60 &&
          request.resource.data.openingMinute == int(request.resource.data.open.split(':')[0]) * 60 + int(request.resource.data.open.split(':')[1]) &&
          request.resource.data.closingMinute == int(request.resource.data.close.split(':')[0]) * 60 + int(request.resource.data.close.split(':')[1]);
        allow delete: if false;
      }
      match /subscriptionPayments/{id} {
        allow read: if billingManager();
        allow create: if globalAdministrator() &&
          request.resource.data.keys().hasOnly(["requestId", "reference", "planId", "plan", "amount", "currency",
            "paymentMethod", "status", "submittedBy", "approvedBy", "paidAt", "currentPeriodEnd"]) &&
          request.resource.data.requestId == id && request.resource.data.reference == id &&
          request.resource.data.approvedBy == request.auth.uid && request.resource.data.paidAt == request.time &&
          request.resource.data.status == "Paid" && request.resource.data.currency == "PHP" &&
          request.resource.data.paymentMethod == "GCash" &&
          get(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.status == "Pending" &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.status == "Approved" &&
          request.resource.data.planId == get(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.planId &&
          request.resource.data.plan == get(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.plan &&
          get(/databases/$(database)/documents/subscriptionReferences/$(id)).data.shopId == shopId &&
          get(/databases/$(database)/documents/subscriptionReferences/$(id)).data.submittedBy ==
            request.resource.data.submittedBy &&
          request.resource.data.amount == get(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.amount &&
          request.resource.data.submittedBy == get(/databases/$(database)/documents/shops/$(shopId)/subscriptionPaymentRequests/$(id)).data.submittedBy &&
          request.resource.data.currentPeriodEnd == getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.currentPeriodEnd;
        allow update, delete: if false;
      }
      match /subscriptionPaymentRequests/{id} {
        function validRequest() {
          let data = request.resource.data;
          let plan = data.planId;
          return billingManager() &&
            data.keys().hasOnly(["shopId", "planId", "plan", "amount", "currency", "paymentMethod", "status",
              "submittedBy", "submittedByName", "transactionReference", "receiptUrl", "receiptPublicId", "createdAt"]) &&
            plan in ["starter", "professional", "business"] &&
            data.plan == (plan == "starter" ? "Starter" : plan == "professional" ? "Professional" : "Business") &&
            data.amount == (plan == "starter" ? 99 : plan == "professional" ? 399 : 599) &&
            data.shopId == shopId && data.currency == "PHP" && data.paymentMethod == "GCash" &&
            data.status == "Pending" && data.submittedBy == request.auth.uid &&
            data.submittedByName == account().name && data.createdAt == request.time &&
            data.transactionReference == id && id.matches('^[A-Z0-9-]{6,40}$') &&
            data.receiptUrl.matches('^https://res[.]cloudinary[.]com/dijbiwcbo/image/upload/[^ ?#]+$') &&
            data.receiptPublicId is string && data.receiptPublicId.size() > 0 && data.receiptPublicId.size() <= 300 &&
            !exists(/databases/$(database)/documents/subscriptionReferences/$(id)) &&
            getAfter(/databases/$(database)/documents/subscriptionReferences/$(id)).data.shopId == shopId &&
            getAfter(/databases/$(database)/documents/subscriptionReferences/$(id)).data.submittedBy == request.auth.uid;
        }
        allow read: if billingManager();
        allow create: if validRequest();
        allow update: if globalAdministrator() && resource.data.status == "Pending" &&
          request.resource.data.status in ["Approved", "Rejected"] &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "approvedBy", "approvedAt", "reviewedBy", "rejectionReason", "updatedAt"
          ]) &&
          (
            (request.resource.data.status == "Approved" && request.resource.data.approvedBy == request.auth.uid &&
              request.resource.data.approvedAt == request.time &&
              getAfter(/databases/$(database)/documents/shops/$(shopId)/subscriptionPayments/$(id)).data.approvedBy == request.auth.uid) ||
            (request.resource.data.status == "Rejected" && request.resource.data.reviewedBy == request.auth.uid &&
              request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() > 0 &&
              request.resource.data.rejectionReason.size() <= 500)
          );
        allow delete: if false;
      }
      match /subscriptionEvents/{id} {
        allow read: if globalAdministrator();
        allow create: if globalAdministrator() &&
          request.resource.data.keys().hasOnly(["action", "planId", "expiresAt", "manualLocked", "reason", "reference", "actorId", "createdAt"]) &&
          request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.planId == getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.planId &&
          request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.currentPeriodEnd &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.updatedAt == request.time;
        allow update, delete: if false;
      }
      match /subscriptionTrials/{id} {
        allow read: if billingManager();
        allow create: if billingManager() && id == "starter" &&
          !exists(/databases/$(database)/documents/shops/$(shopId)/settings/subscription) &&
          request.resource.data.keys().hasOnly(["planId", "startedAt", "startedBy", "startedByName"]) &&
          request.resource.data.planId == "starter" && request.resource.data.startedAt == request.time &&
          request.resource.data.startedBy == request.auth.uid &&
          request.resource.data.startedByName == account().name &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.status == "Trial" &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.trialDays == 7 &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.trialStartedAt == request.time &&
          getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/subscription).data.startedBy == request.auth.uid;
        allow update, delete: if false;
      }
      match /notifications/{id} {
        function acceptedProviderNotification() {
          let data = request.resource.data;
          let before = get(/databases/$(database)/documents/shops/$(shopId)/appointments/$(data.appointmentId)).data;
          let after = appointment(data.appointmentId);
          return manager() &&
            before.status in ["Pending", "Pending Approval"] &&
            after.status == "Accepted" && after.acceptedAt == request.time &&
            after.updatedAt == request.time && after.get("providerId", "") != "" &&
            data.userId == after.providerId &&
            exists(/databases/$(database)/documents/shops/$(shopId)/members/$(data.userId)) &&
            get(/databases/$(database)/documents/shops/$(shopId)/team/$(data.userId)).data.role == "Service Provider";
        }
        // The appointment's update rule validates authorization and immutable
        // fields. Do not repeat that full rule for the paired notification.
        function transitionNotification() {
          let data = request.resource.data;
          let before = get(/databases/$(database)/documents/shops/$(shopId)/appointments/$(data.appointmentId)).data;
          let after = appointment(data.appointmentId);
          return data.userId == before.customerId &&
            after.customerId == before.customerId && after.updatedAt == request.time &&
            (
              (before.status in ["Pending", "Pending Approval"] && after.status in ["Accepted", "Rejected"]) ||
              (before.status in ["Confirmed", "Accepted"] && after.status == "In Progress") ||
              (before.status in ["In Progress", "In Service"] && after.status == "Completed") ||
              (before.status in ["Pending", "Pending Approval", "Confirmed", "Accepted", "In Progress", "In Service"] && after.status == "Cancelled")
            );
        }
        allow read: if administrator() || (member() && resource.data.userId == request.auth.uid);
        allow update: if (administrator() || (member() && resource.data.userId == request.auth.uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]) && request.resource.data.read == true;
        allow create: if member() &&
          request.resource.data.keys().hasAll(["userId", "title", "message", "read", "appointmentId", "createdAt"]) &&
          request.resource.data.keys().hasOnly(["userId", "title", "message", "read", "appointmentId", "createdAt"]) &&
          request.resource.data.userId is string && request.resource.data.userId.size() > 0 &&
          request.resource.data.appointmentId is string && request.resource.data.appointmentId.size() > 0 &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
          request.resource.data.message is string && request.resource.data.message.size() <= 1000 &&
          request.resource.data.read == false && request.resource.data.createdAt == request.time &&
          (request.resource.data.userId == request.auth.uid || acceptedProviderNotification() || (manager() &&
            request.resource.data.userId == appointment(request.resource.data.appointmentId).customerId && appointment(request.resource.data.appointmentId).createdBy == request.auth.uid && appointment(request.resource.data.appointmentId).createdAt == request.time) || transitionNotification() || (cashier() &&
            request.resource.data.userId == appointment(request.resource.data.appointmentId).customerId &&
            getAfter(/databases/$(database)/documents/shops/$(shopId)/payments/$(request.resource.data.appointmentId)).data.createdBy == request.auth.uid &&
            getAfter(/databases/$(database)/documents/shops/$(shopId)/payments/$(request.resource.data.appointmentId)).data.createdAt == request.time));
        allow delete: if administrator() || (member() && resource.data.userId == request.auth.uid);
      }
      // Server-only SMS state. The Cloudflare service account uses IAM.
      match /smsDeliveries/{id} { allow read, write: if false; }
      match /smsWorkerState/{id} { allow read, write: if false; }
      match /{document=**} { allow read, write: if false; }
      match /promotions/{id} {
        allow read: if member();
        allow create, update: if shopManager() && request.resource.data.title is string && request.resource.data.description is string;
        allow delete: if shopManager();
      }
      match /reviews/{id} {
        function validReview() {
          let data = request.resource.data;
          let before = get(/databases/$(database)/documents/shops/$(shopId)/appointments/$(id)).data;
          let after = appointment(id);
          let fields = ["appointmentId", "customerId", "providerId", "serviceId", "serviceRating", "providerRating", "rating", "comment", "createdBy", "createdAt"];
          return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&
            data.appointmentId == id && data.customerId == request.auth.uid &&
            data.createdBy == request.auth.uid && data.createdAt == request.time &&
            data.serviceRating is int && data.serviceRating >= 1 && data.serviceRating <= 5 &&
            data.rating == data.serviceRating &&
            data.providerRating is int && data.providerRating >= 1 && data.providerRating <= 5 &&
            data.providerId is string && data.providerId.size() > 0 && data.providerId == before.providerId &&
            data.serviceId is string && data.serviceId == before.get("serviceId", "") &&
            data.comment is string && data.comment.size() <= 1000 &&
            before.customerId == request.auth.uid && before.status == "Completed" &&
            after.status == "Rated" && after.reviewId == id &&
            after.ratedAt == request.time && after.updatedAt == request.time;
        }
        allow get: if member() && (
          manager() ||
          (role() == "Customer" &&
            exists(/databases/$(database)/documents/shops/$(shopId)/appointments/$(id)) &&
            get(/databases/$(database)/documents/shops/$(shopId)/appointments/$(id)).data.customerId == request.auth.uid) ||
          (role() == "Customer" && owner(resource.data)) ||
          assigned(resource.data)
        );
        allow list: if member() && (
          manager() ||
          (role() == "Customer" && owner(resource.data)) ||
          assigned(resource.data)
        );
        allow create: if member() && role() == "Customer" && validReview();
        allow delete: if recordDeleter() &&
          !existsAfter(/databases/$(database)/documents/shops/$(shopId)/appointments/$(id)) &&
          ledgersDeleted(id);
        allow update: if false;
      }
    }
    match /feedback/{id} {
      allow read: if globalAdministrator() ||
        (signedIn() && resource.data.senderId == request.auth.uid);
      allow create: if signedIn() &&
        account().role in ["Manager", "Service Provider", "Customer"] &&
        request.resource.data.keys().hasOnly([
          "subject", "message", "category", "shopId", "shopName",
          "senderId", "senderName", "senderRole", "status", "createdAt"
        ]) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderName == account().name &&
        request.resource.data.senderRole == account().role &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 2 && request.resource.data.subject.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000 &&
        request.resource.data.category in ["Bug", "Booking", "Payment", "Account", "Other"] &&
        request.resource.data.status == "New" && request.resource.data.createdAt == request.time &&
        request.resource.data.shopId is string && request.resource.data.shopId.size() <= 128 &&
        (request.resource.data.shopId == "" || request.resource.data.shopId.matches('^[^/]+$')) &&
        request.resource.data.shopName is string && request.resource.data.shopName.size() <= 120 &&
        (
          (request.resource.data.shopId == "" && request.resource.data.shopName == "") ||
          (exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/members/$(request.auth.uid)) &&
            request.resource.data.shopName == get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.name)
        );
      allow update: if globalAdministrator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedBy", "updatedAt"]) &&
        request.resource.data.status in ["New", "Reviewed"] &&
        request.resource.data.reviewedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /subscriptionReferences/{id} {
      allow get: if globalAdministrator();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["shopId", "submittedBy", "createdAt"]) &&
        request.resource.data.submittedBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        id.matches('^[A-Z0-9-]{6,40}$') &&
        getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/subscriptionPaymentRequests/$(id)).data.submittedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/subscriptionPaymentRequests/$(id)).data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
