rules_version = '2';
service cloud.firestore {
  // Google and password sign-in use the same authenticated UID permissions.
  // OAuth authorized domains are configured in Firebase Authentication, not here.
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function globalAdministrator() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        account().get("role", "") == "Administrator";
    }
    function validName(value) { return value is string && value.size() >= 2 && value.size() <= 120; }
    function licenseActive(data) {
      return data.get("manualLocked", false) == false && (
        (data.status == "Active" && data.expiresAt is timestamp && data.expiresAt > request.time) ||
        (data.status == "Trial" && data.trialStartedAt is timestamp &&
          data.trialStartedAt + duration.value(7, 'd') > request.time)
      );
    }
    function shopAccessActive(shopId) {
      return licenseActive(get(/databases/$(database)/documents/shops/$(shopId)/settings/access).data);
    }
    function currentShopRole() {
      return globalAdministrator() ? "Administrator" : (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        account().get("activeShopId", "") != "" && shopAccessActive(account().activeShopId) &&
        exists(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(request.auth.uid))
          ? get(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(request.auth.uid)).data.get("role", "")
          : ""
      );
    }
    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || globalAdministrator() || (
        currentShopRole() in ["Administrator", "Manager"] &&
        exists(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(uid))
      ));
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == uid && validName(request.resource.data.name) &&
        request.resource.data.createdAt == request.time && (
          (uid == request.auth.uid && request.resource.data.keys().hasOnly(["uid", "name", "email", "role", "createdAt"]) &&
            request.resource.data.role == "Customer" && request.resource.data.email == request.auth.token.email) ||
          (uid != request.auth.uid && currentShopRole() in ["Administrator", "Manager"] &&
            request.resource.data.keys().hasOnly(["uid", "name", "email", "role", "createdAt", "createdBy", "shopId", "activeShopId"]) &&
            request.resource.data.email is string && request.resource.data.createdBy == request.auth.uid && (
              (request.resource.data.role == "Service Provider" && request.resource.data.shopId == account().activeShopId &&
                request.resource.data.activeShopId == account().activeShopId &&
                getAfter(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(uid)).data.role == "Service Provider") ||
              (currentShopRole() == "Administrator" && request.resource.data.role in ["Administrator", "Manager"] &&
                !request.resource.data.keys().hasAny(["shopId", "activeShopId"]))
            ))
        );
      allow update: if signedIn() && request.resource.data.updatedAt == request.time && (
        (uid == request.auth.uid && globalAdministrator() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeShopId", "updatedAt"]) &&
          request.resource.data.activeShopId is string &&
          exists(/databases/$(database)/documents/shops/$(request.resource.data.activeShopId))) ||
        ((uid == request.auth.uid || globalAdministrator()) &&
          validName(request.resource.data.name) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])) ||
        (uid == request.auth.uid && resource.data.role == "Customer" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeShopId", "joinedShopIds", "updatedAt"]) &&
          request.resource.data.activeShopId is string && request.resource.data.joinedShopIds is list &&
          request.resource.data.joinedShopIds.size() <= 50 &&
          request.resource.data.joinedShopIds.size() == request.resource.data.joinedShopIds.toSet().size() &&
          request.resource.data.joinedShopIds.hasAll(resource.data.get("joinedShopIds", [])) &&
          request.resource.data.joinedShopIds.toSet().difference(resource.data.get("joinedShopIds", []).toSet()).hasOnly([request.resource.data.activeShopId]) &&
          request.resource.data.activeShopId in request.resource.data.joinedShopIds &&
          getAfter(/databases/$(database)/documents/shops/$(request.resource.data.activeShopId)/members/$(uid)).data.role == "Customer" &&
          (exists(/databases/$(database)/documents/shops/$(request.resource.data.activeShopId)/members/$(uid)) ||
            (get(/databases/$(database)/documents/shops/$(request.resource.data.activeShopId)).data.active == true &&
              get(/databases/$(database)/documents/shops/$(request.resource.data.activeShopId)).data.acceptingCustomers == true))) ||
        (uid == request.auth.uid && resource.data.role in ["Administrator", "Manager"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["shopId", "activeShopId", "updatedAt"]) &&
          request.resource.data.shopId == uid && request.resource.data.activeShopId == uid &&
          getAfter(/databases/$(database)/documents/shops/$(uid)).data.ownerId == uid &&
          getAfter(/databases/$(database)/documents/shops/$(uid)/members/$(uid)).data.role == resource.data.role) ||
        (uid != request.auth.uid && currentShopRole() == "Administrator" &&
          (globalAdministrator() || resource.data.role != "Customer") &&
          exists(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "shopId", "activeShopId", "joinedShopIds", "updatedAt"]) &&
          request.resource.data.role in ["Administrator", "Manager", "Service Provider", "Customer"] &&
          getAfter(/databases/$(database)/documents/shops/$(account().activeShopId)/members/$(uid)).data.role == request.resource.data.role &&
          getAfter(/databases/$(database)/documents/shops/$(account().activeShopId)/team/$(uid)).data.role == request.resource.data.role &&
          request.resource.data.get("shopId", account().activeShopId) == account().activeShopId)
      );
      allow delete: if false;
    }
    match /shops/{shopId} {
      function rawMember() { return signedIn() && (exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)) || globalAdministrator()); }
      function billingManager() {
        return globalAdministrator() || (signedIn() &&
          exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role in ["Manager", "Administrator"]);
      }
      function member() {
        return signedIn() && (
          (exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)) &&
            (get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role == "Customer" || shopAccessActive(shopId))) ||
          globalAdministrator());
      }
      function shopManager() { return manager(); }
      function directoryFields() {
        return request.resource.data.keys().hasOnly(["name", "ownerId", "managerName", "location", "description", "serviceCategories", "logoUrl", "themeColor", "active", "acceptingCustomers", "createdAt", "updatedAt", "open", "close", "facebookUrl"]) &&
          request.resource.data.get("facebookUrl", "") is string &&
          request.resource.data.get("facebookUrl", "").size() <= 2000 &&
          (
            request.resource.data.get("facebookUrl", "") == "" ||
            request.resource.data.facebookUrl.matches('^https://(www[.]|m[.]|web[.])?facebook[.]com(/.*)?$') ||
            request.resource.data.facebookUrl.matches('^https://fb[.]me(/.*)?$')
          ) &&
          (
            !request.resource.data.keys().hasAny(["facebookUrl"]) ||
            request.resource.data.facebookUrl ==
              getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/business).data.get("facebookUrl", "")
          ) &&
          (
            !request.resource.data.keys().hasAny(["open", "close"]) ||
            (
              request.resource.data.keys().hasAll(["open", "close"]) &&
              request.resource.data.open is string &&
              request.resource.data.close is string &&
              request.resource.data.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
              request.resource.data.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
              request.resource.data.open < request.resource.data.close &&
              request.resource.data.open == getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/business).data.open &&
              request.resource.data.close == getAfter(/databases/$(database)/documents/shops/$(shopId)/settings/business).data.close
            )
          ) &&
          request.resource.data.get("themeColor", "forest") in ["forest", "ocean", "plum", "bronze"] &&
          validName(request.resource.data.name) && validName(request.resource.data.managerName) &&
          request.resource.data.location is string && request.resource.data.location.size() <= 300 &&
          request.resource.data.description is string && request.resource.data.description.size() <= 1000 &&
          request.resource.data.serviceCategories is list && request.resource.data.serviceCategories.size() <= 30 &&
          request.resource.data.logoUrl is string &&
          (request.resource.data.logoUrl == "" || request.resource.data.logoUrl.matches('^https://.+$')) &&
          request.resource.data.active is bool && request.resource.data.acceptingCustomers is bool && request.resource.data.updatedAt == request.time;
      }
      allow get: if signedIn() && (shopId == request.auth.uid ||
        !exists(/databases/$(database)/documents/shops/$(shopId)) || rawMember() || resource.data.active == true);
      allow list: if globalAdministrator() || (signedIn() && resource.data.active == true);
      allow create: if signedIn() && shopId == request.auth.uid && account().role in ["Administrator", "Manager"] &&
        request.resource.data.ownerId == request.auth.uid && request.resource.data.managerName == account().name &&
        request.resource.data.createdAt == request.time && directoryFields() &&
        getAfter(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role == account().role;
      allow update: if shopManager() && directoryFields() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "managerName", "location", "description", "serviceCategories", "logoUrl", "themeColor", "active", "acceptingCustomers", "updatedAt", "open", "close", "facebookUrl"]);
      allow delete: if false;
      match /members/{uid} {
        function selfCustomer() { return signedIn() && uid == request.auth.uid && account().role == "Customer"; }
        allow get: if signedIn() && (uid == request.auth.uid || shopManager());
        allow list: if shopManager();
        allow create: if signedIn() && request.resource.data.uid == uid && validName(request.resource.data.name) &&
          request.resource.data.email is string && request.resource.data.joinedAt == request.time &&
          request.resource.data.keys().hasOnly(["uid", "name", "email", "role", "joinedAt"]) && (
            (selfCustomer() && request.resource.data.role == "Customer" &&
              request.resource.data.name == account().name && request.resource.data.email == account().email &&
              get(/databases/$(database)/documents/shops/$(shopId)).data.active == true &&
              get(/databases/$(database)/documents/shops/$(shopId)).data.acceptingCustomers == true &&
              getAfter(/databases/$(database)/documents/users/$(uid)).data.activeShopId == shopId) ||
            (uid == request.auth.uid && shopId == uid && account().role in ["Administrator", "Manager"] &&
              request.resource.data.role == account().role && request.resource.data.name == account().name &&
              request.resource.data.email == account().email && getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == uid) ||
            (shopManager() && request.resource.data.role == "Service Provider" &&
              getAfter(/databases/$(database)/documents/users/$(uid)).data.shopId == shopId &&
              getAfter(/databases/$(database)/documents/users/$(uid)).data.role == "Service Provider" &&
              request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(uid)).data.name &&
              request.resource.data.email == getAfter(/databases/$(database)/documents/users/$(uid)).data.email)
          );
        allow update: if signedIn() && (
          ((uid == request.auth.uid || globalAdministrator()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"]) &&
            request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(uid)).data.name && request.resource.data.updatedAt == request.time) ||
          (shopManager() && (globalAdministrator() || get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role == "Administrator") && uid != request.auth.uid &&
            (globalAdministrator() || resource.data.role != "Customer") &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "updatedAt"]) && request.resource.data.updatedAt == request.time &&
            request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(uid)).data.role)
        );
        allow delete: if false;
      }

      function signedIn() { return request.auth != null; }
      function role() {
        let membership = signedIn() && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid))
          ? get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.get("role", "") : "";
        return globalAdministrator() ? "Administrator" : (
          membership == "Customer" || (membership != "" && shopAccessActive(shopId))
            ? membership
            : ""
        );
      }
      function manager() { return signedIn() && role() in ["Administrator", "Manager"]; }
      function administrator() { return signedIn() && role() == "Administrator"; }
      function recordEditor() {
        return globalAdministrator() || (role() == "Manager" &&
          account().get("role", "") == "Manager" &&
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid);
      }
      function recordTimeUnchanged(before, after) {
        return after.get("date", null) == before.get("date", null) &&
          after.get("durationMinutes", null) == before.get("durationMinutes", null) &&
          after.get("time", null) == before.get("time", null) &&
          after.get("startMinute", null) == before.get("startMinute", null) &&
          after.get("startsAt", null) == before.get("startsAt", null);
      }
      function adminWalkInDetails(before, after) {
        return (after.get("method", "") == before.get("method", "") ||
            after.method in ["Cash", "E-wallet"]) &&
          (after.get("providerId", "") == before.get("providerId", "") ||
            (after.providerId is string && after.providerId.size() > 0 &&
              get(/databases/$(database)/documents/shops/$(shopId)/team/$(after.providerId)).data.active == true &&
              get(/databases/$(database)/documents/shops/$(shopId)/team/$(after.providerId)).data.role == "Service Provider" &&
              after.provider == get(/databases/$(database)/documents/shops/$(shopId)/team/$(after.providerId)).data.name));
      }
      // Corrections preserve identity and creation metadata and require a server audit.
      function adminRecordCorrection() {
        // Normal booking writes carry no fresh correction audit. Keep this
        // exceptional path cheap without changing their reservation permissions.
        return request.resource.data.get("editedByAdmin", "") == request.auth.uid &&
          request.resource.data.get("adminEditedAt", null) == request.time &&
          recordEditor() &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.date is string &&
          request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          validName(request.resource.data.client) &&
          request.resource.data.amount is number && request.resource.data.amount >= 0 &&
          request.resource.data.amountCents is int &&
          request.resource.data.amountCents == math.round(request.resource.data.amount * 100) &&
          recordTimeUnchanged(resource.data, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "client", "customerId", "email", "phone", "service", "serviceId",
            "serviceIds", "serviceNames", "serviceAmounts", "provider", "providerId",
            "requestedProviderId", "providerPreference", "reservedProviderId",
            "scheduleId", "slotKeys",
            "amount", "amountCents", "method", "status", "paymentStatus", "notes", "rejectionReason",
            "editedByAdmin", "adminEditedAt", "updatedAt"
          ]);
      }
      function cashier() { return signedIn() && role() in ["Administrator", "Manager", "Service Provider"]; }
      function owner(data) { return signedIn() && role() == "Customer" && data.get("customerId", "") == request.auth.uid; }
      // Date corrections are permanently revoked, including for old clients.
      function temporaryManagerDateEditingEnabled() { return false; }
      // Temporary cleanup access is independent of date/time editing.
      function temporaryManagerRecordDeletionEnabled() { return true; }
      function recordDeleter() {
        return globalAdministrator() || (temporaryManagerRecordDeletionEnabled() &&
          role() == "Manager" && account().get("role", "") == "Manager");
      }
      function ledgersDeleted(id) {
        return !existsAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(id)) &&
          !existsAfter(/databases/$(database)/documents/shops/$(shopId)/payments/$(id));
      }
      function bookingSlotsReleased(id, data) {
        let scheduleId = data.get("scheduleId", "");
        return scheduleId == "" ||
          !existsAfter(/databases/$(database)/documents/shops/$(shopId)/appointmentSchedules/$(scheduleId)) ||
          !getAfter(/databases/$(database)/documents/shops/$(shopId)/appointmentSchedules/$(scheduleId)).data.slots.values().hasAny([id]);
      }
      function managerDateCorrection(before, after, booking) {
        let parts = after.date.split('-');
        // The whitelist freezes time/start-minute/slot keys. Booking-specific
        // validation below keeps startsAt at that same clock time on a new date.
        return before is map && before.keys().hasAll(["date"]) &&
          after.date != before.date &&
          temporaryManagerDateEditingEnabled() && role() == "Manager" &&
          account().get("role", "") == "Manager" &&
          after.date is string && after.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) is timestamp &&
          (!after.keys().hasAny(["time"]) ||
            (after.time is string && after.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
          after.dateEditedBy == request.auth.uid &&
          after.dateEditedAt == request.time && after.updatedAt == request.time &&
          after.diff(before).affectedKeys().hasOnly(booking
            ? ["date", "startsAt", "scheduleId", "dateEditedBy", "dateEditedAt", "updatedAt"]
            : ["date", "dateEditedBy", "dateEditedAt", "updatedAt"]);
      }
      function managerLinkedDates(id, data) {
        return (
          !exists(/databases/$(database)/documents/shops/$(shopId)/sales/$(id)) ||
          (getAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(id)).data.date == data.date &&
            getAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(id)).data.dateEditedAt == request.time)
        ) && (
          !exists(/databases/$(database)/documents/shops/$(shopId)/payments/$(id)) ||
          (getAfter(/databases/$(database)/documents/shops/$(shopId)/payments/$(id)).data.date == data.date &&
            getAfter(/databases/$(database)/documents/shops/$(shopId)/payments/$(id)).data.dateEditedAt == request.time)
        );
      }
      function managerCorrectedSlotKeys(data) {
        let count = data.slotKeys.size();
        let first = data.startMinute - data.startMinute % 15;
        let text = data.slotKeys.join(',');
        let expected = [
          string(first), string(first + 15), string(first + 30), string(first + 45),
          string(first + 60), string(first + 75), string(first + 90), string(first + 105),
          string(first + 120), string(first + 135), string(first + 150), string(first + 165),
          string(first + 180), string(first + 195), string(first + 210), string(first + 225),
          string(first + 240)
        ].join(',');
        return data.startMinute is int && data.startMinute >= 0 &&
          data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 240 &&
          data.startMinute + data.durationMinutes <= 1440 &&
          data.slotKeys is list && count >= 1 && count <= 17 &&
          count * 15 >= data.startMinute % 15 + data.durationMinutes &&
          (count - 1) * 15 < data.startMinute % 15 + data.durationMinutes &&
          text.matches('^[0-9]+(,[0-9]+){' + string(count - 1) + '}$') &&
          expected.matches('^' + text + '(,.*)?$');
      }
      function managerOwnsSlots(slots, keys, id) {
        let count = keys.size();
        return count >= 1 && count <= 17 && slots.keys().hasAll(keys) &&
          slots[keys[0]] == id &&
          (count < 2 || slots[keys[1]] == id) &&
          (count < 3 || slots[keys[2]] == id) &&
          (count < 4 || slots[keys[3]] == id) &&
          (count < 5 || slots[keys[4]] == id) &&
          (count < 6 || slots[keys[5]] == id) &&
          (count < 7 || slots[keys[6]] == id) &&
          (count < 8 || slots[keys[7]] == id) &&
          (count < 9 || slots[keys[8]] == id) &&
          (count < 10 || slots[keys[9]] == id) &&
          (count < 11 || slots[keys[10]] == id) &&
          (count < 12 || slots[keys[11]] == id) &&
          (count < 13 || slots[keys[12]] == id) &&
          (count < 14 || slots[keys[13]] == id) &&
          (count < 15 || slots[keys[14]] == id) &&
          (count < 16 || slots[keys[15]] == id) &&
          (count < 17 || slots[keys[16]] == id);
      }
      function managerBookingDateCorrection(id, before, after) {
        let parts = after.date.split('-');
        let time = after.get("time", "").split(':');
        let holdsSlots = before.get("scheduleId", "") != "" && !(before.status in ["Cancelled", "Rejected"]);
        let holder = before.get("reservedProviderId", "") != "" ? before.reservedProviderId : before.get("providerId", "");
        return managerDateCorrection(before, after, true) &&
          managerLinkedDates(id, after) &&
          (after.get("time", "") == ""
            ? (after.get("startsAt", null) == before.get("startsAt", null) &&
                after.get("startMinute", null) == before.get("startMinute", null))
            : (after.startMinute == int(time[0]) * 60 + int(time[1]) &&
                after.startsAt == timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) +
                  duration.value(after.startMinute - 480, 'm'))) &&
          after.get("scheduleId", "") == (holdsSlots ? holder + '_' + after.date : before.get("scheduleId", "")) &&
          (holdsSlots ? (
            managerCorrectedSlotKeys(after) &&
            !getAfter(/databases/$(database)/documents/shops/$(shopId)/appointmentSchedules/$(before.scheduleId)).data.slots.keys().hasAny(
              before.slotKeys.removeAll(before.scheduleId == after.scheduleId ? after.slotKeys : [])) &&
            slotsHeld(after, id)
          ) : after.get("slotKeys", []) == before.get("slotKeys", []));
      }
      function validRole(value) { return value in ["Administrator", "Manager", "Service Provider", "Customer"]; }
      function appointment(id) { return getAfter(/databases/$(database)/documents/shops/$(shopId)/appointments/$(id)).data; }
      function assigned(data) {
        let currentRole = role();
        return signedIn() && data.get("providerId", "") == request.auth.uid &&
        (currentRole == "Service Provider" || (currentRole == "Manager" &&
          get(/databases/$(database)/documents/shops/$(shopId)/team/$(request.auth.uid)).data.role == "Service Provider" &&
          get(/databases/$(database)/documents/shops/$(shopId)/team/$(request.auth.uid)).data.active == true));
      }
      function canCollect(data) {
        let currentRole = role();
        return currentRole in ["Administrator", "Manager"] || (
          currentRole == "Service Provider" && data.get("providerId", "") == request.auth.uid &&
          get(/databases/$(database)/documents/shops/$(shopId)/team/$(request.auth.uid)).data.active == true &&
          get(/databases/$(database)/documents/shops/$(shopId)/team/$(request.auth.uid)).data.role == "Service Provider"
        );
      }
      function availableForAssignment(data) {
        return role() == "Service Provider" &&
          data.get("providerId", "") == "" &&
          data.get("providerPreference", "") == "any" &&
          data.status == "Accepted";
      }
      function canCreateBooking(data) {
        let currentRole = role();
        return currentRole in ["Administrator", "Manager"] ||
          (currentRole == "Customer" && data.customerId == request.auth.uid &&
            data.client == get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.name);
      }
      function validAssignment(before, after, id) {
        let targetId = after.get("providerId", "");
        let target = targetId != ""
          ? get(/databases/$(database)/documents/shops/$(shopId)/team/$(targetId)).data : {};
        return before.get("status", "") == "Accepted" && after.status == before.status &&
          before.get("providerPreference", "") == "any" && before.get("providerId", "") == "" &&
          after.providerId is string && after.providerId != "" &&
          (manager() || (role() == "Service Provider" && after.providerId == request.auth.uid)) &&
          target.active == true && target.role == "Service Provider" && after.provider == target.name &&
          (get(/databases/$(database)/documents/shops/$(shopId)/settings/business).data.get("shopType", "team") != "solo" ||
            after.providerId == get(/databases/$(database)/documents/shops/$(shopId)/settings/business).data.managerProviderId) &&
          after.reservedProviderId == after.providerId &&
          after.scheduleId == after.providerId + '_' + before.date &&
          after.assignedBy == request.auth.uid && after.assignedAt == request.time &&
          after.updatedAt == request.time &&
